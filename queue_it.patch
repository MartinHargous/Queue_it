+/* Queue it — tema oscuro de sala de ensayo.
+   Ámbar = tiempo (pulso, play, compás). Verde agua = voces/cues. */
+:root {
+  --bg: #1a1917;
+  --surface: #23211e;
+  --raised: #2e2b27;
+  --line: #3d3934;
+  --text: #edeae0;
+  --muted: #a49c90;
+  --amber: #f2a93b;
+  --amber-ink: #231703;
+  --teal: #74c3c0;
+  --red: #e2674f;
+  --wave: #5f5a52;
+  --grid: #4e4a44;
+
+  --display: 'Barlow Condensed', 'Roboto Condensed', 'Arial Narrow', sans-serif;
+  --body: 'Atkinson Hyperlegible', system-ui, sans-serif;
+
+  --r-sm: 6px;
+  --r-md: 12px;
+  --tap: 48px;
+  --safe-b: env(safe-area-inset-bottom, 0px);
+
+  color-scheme: dark;
+  font: 400 16px/1.45 var(--body);
+  color: var(--text);
+  background: var(--bg);
+  -webkit-font-smoothing: antialiased;
+  -webkit-tap-highlight-color: transparent;
+}
+
+* {
+  box-sizing: border-box;
+}
+html,
+body,
+#root {
+  margin: 0;
+  height: 100%;
+}
+body {
+  overscroll-behavior-y: none;
+}
+button,
+input,
+select,
+textarea {
+  font: inherit;
+  color: inherit;
+}
+button {
+  cursor: pointer;
+  touch-action: manipulation;
+}
+button:disabled {
+  opacity: 0.4;
+  cursor: default;
+}
+:focus-visible {
+  outline: 2px solid var(--amber);
+  outline-offset: 2px;
+}
+h1,
+h2,
+h3,
+p {
+  margin: 0;
+}
+.muted {
+  color: var(--muted);
+}
+.hint {
+  color: var(--muted);
+  font-size: 0.875rem;
+}
+
+/* ---------- estructura de pantalla ---------- */
+.screen {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  max-width: 640px;
+  margin: 0 auto;
+}
+.appbar {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  min-height: 56px;
+  padding: env(safe-area-inset-top, 0px) 8px 0;
+  flex-shrink: 0;
+}
+.home-bar {
+  padding-left: 20px;
+}
+.wordmark {
+  font: 700 2rem/1 var(--display);
+  letter-spacing: 0.01em;
+}
+.title-btn,
+.title-input {
+  flex: 1;
+  min-width: 0;
+  font: 600 1.35rem/1.2 var(--display);
+  text-align: left;
+  background: none;
+  border: 0;
+  padding: 8px 6px;
+  border-radius: var(--r-sm);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.title-input {
+  background: var(--surface);
+  outline: 1px solid var(--line);
+}
+.icon-btn {
+  display: inline-grid;
+  place-items: center;
+  width: var(--tap);
+  height: var(--tap);
+  border: 0;
+  border-radius: 50%;
+  background: none;
+  flex-shrink: 0;
+}
+.icon-btn:active {
+  background: var(--raised);
+}
+.is-danger {
+  color: var(--red);
+}
+
+/* ---------- botones ---------- */
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  min-height: var(--tap);
+  padding: 0 18px;
+  border-radius: var(--r-md);
+  border: 1px solid var(--line);
+  background: var(--surface);
+  font-weight: 700;
+}
+.btn:active:not(:disabled) {
+  background: var(--raised);
+}
+.btn-primary {
+  background: var(--amber);
+  border-color: var(--amber);
+  color: var(--amber-ink);
+}
+.btn-primary:active:not(:disabled) {
+  background: #d99429;
+}
+.btn-ghost {
+  background: none;
+  border-color: transparent;
+}
+.btn-block {
+  width: 100%;
+}
+.btn.is-danger {
+  border-color: color-mix(in srgb, var(--red) 45%, var(--line));
+}
+.grow {
+  flex: 1;
+}
+
+/* ---------- inicio ---------- */
+.home-list {
+  flex: 1;
+  overflow-y: auto;
+  padding: 8px 12px 24px;
+}
+.project-list,
+.cue-list,
+.section-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+.project-row {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  width: 100%;
+  padding: 14px 8px;
+  border: 0;
+  border-bottom: 1px solid var(--line);
+  background: none;
+  text-align: left;
+}
+.project-kind {
+  color: var(--amber);
+  display: grid;
+}
+.project-main {
+  flex: 1;
+  min-width: 0;
+  display: grid;
+}
+.project-title {
+  font: 600 1.3rem/1.2 var(--display);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.project-meta {
+  color: var(--muted);
+  font-size: 0.875rem;
+}
+.project-dur {
+  font: 500 1.15rem var(--display);
+  color: var(--muted);
+  font-variant-numeric: tabular-nums;
+}
+.bottom-action {
+  padding: 12px 16px calc(12px + var(--safe-b));
+  border-top: 1px solid var(--line);
+}
+.empty {
+  padding: 48px 12px;
+  display: grid;
+  gap: 8px;
+  max-width: 34ch;
+}
+.empty.small {
+  padding: 24px 4px;
+}
+.empty-title {
+  font: 600 1.5rem var(--display);
+}
+.choice-list {
+  display: grid;
+  gap: 10px;
+}
+.choice {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 16px;
+  text-align: left;
+  border-radius: var(--r-md);
+  border: 1px solid var(--line);
+  background: var(--surface);
+}
+.choice > svg {
+  color: var(--amber);
+}
+.choice span {
+  display: grid;
+}
+.choice strong {
+  font: 600 1.25rem var(--display);
+}
+
+/* ---------- editor ---------- */
+.editor .panel {
+  flex: 1;
+  overflow-y: auto;
+  padding: 16px 16px 32px;
+}
+.tabs {
+  display: flex;
+  border-bottom: 1px solid var(--line);
+  padding: 0 8px;
+  flex-shrink: 0;
+}
+.tabs button {
+  flex: 1;
+  min-height: var(--tap);
+  background: none;
+  border: 0;
+  border-bottom: 2px solid transparent;
+  color: var(--muted);
+  font-weight: 700;
+  display: inline-flex;
+  justify-content: center;
+  align-items: center;
+  gap: 6px;
+}
+.tabs .is-active {
+  color: var(--text);
+  border-bottom-color: var(--amber);
+}
+.tab-count {
+  font: 600 0.85rem var(--display);
+  color: var(--teal);
+}
+
+/* mapa de pista */
+.trackmap {
+  position: relative;
+  height: 40px;
+  margin: 0 16px 10px;
+  border-radius: var(--r-sm);
+  background: var(--surface);
+  overflow: hidden;
+  flex-shrink: 0;
+}
+.trackmap.is-seekable {
+  cursor: pointer;
+}
+.trackmap-block {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  border-right: 1px solid var(--bg);
+  background: var(--raised);
+  padding: 3px 6px;
+  overflow: hidden;
+}
+.trackmap-block span {
+  font: 500 0.85rem/1 var(--display);
+  color: var(--muted);
+  white-space: nowrap;
+}
+.trackmap-block:nth-child(even) {
+  background: color-mix(in srgb, var(--raised) 70%, var(--surface));
+}
+.trackmap-cue {
+  position: absolute;
+  bottom: 0;
+  width: 3px;
+  height: 14px;
+  margin-left: -1px;
+  background: var(--teal);
+  border-radius: 1px;
+}
+.trackmap-head {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  width: 2px;
+  margin-left: -1px;
+  background: var(--amber);
+  box-shadow: 0 0 0 1px var(--bg);
+}
+
+/* secciones */
+.stack {
+  display: grid;
+  gap: 14px;
+}
+.section {
+  border-left: 3px solid var(--line);
+  margin-bottom: 8px;
+  background: var(--surface);
+  border-radius: 0 var(--r-md) var(--r-md) 0;
